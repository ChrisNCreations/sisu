[TEMPLATE]
# Private key for deployment (with or without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL (you can get one from Alchemy, Infura, or other providers)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# BuildBear custom network RPC (legacy demo network; not part of the Sepolia release)
BUILDBEAR_RPC_URL=https://rpc.buildbear.io/YOUR_NODE

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Sisu public (Sepolia) deployment -------------------------------------
# Required for `npm run deploy:sisu:sepolia`. Never used on local networks,
# which always deploy local mocks instead.
# Required explicit broadcast opt-in. Keep unset for read-only validation or probes.
SISU_ALLOW_LIVE_DEPLOYMENT=false
# Required by `npm run seed:sepolia`; both wallets must already have Sepolia gas
# and enough configured WETH/USDC for the canonical 1 ETH + 3000 USDC strategy.
SISU_MAKER_PRIVATE_KEY=
SISU_TRADER_PRIVATE_KEY=
#
# Canonical Sepolia WETH is the ERC-20 ETH leg. Never deploy a mock asset here.
SISU_WETH_ADDRESS=
# Configured Sepolia faucet USDC (must be an ERC-20 with a readable decimals()).
SISU_USDC_ADDRESS=
# Configured Sepolia Chainlink ETH/USD AggregatorV3 feed.
SISU_ORACLE_ADDRESS=
# Maximum accepted age of the latest oracle round, in seconds.
SISU_ORACLE_MAX_STALENESS=86400
# Expected Chainlink heartbeat, in seconds (must not exceed SISU_ORACLE_MAX_STALENESS).
SISU_ORACLE_HEARTBEAT=86400
# Optional pins; when set they must match the on-chain metadata exactly.
# SISU_WETH_DECIMALS=18
# SISU_USDC_DECIMALS=6
# SISU_ORACLE_DECIMALS=8

# Optional: WETH address for the template AquaSwapVMRouter deployment
# (defaults to the canonical address on mainnet/sepolia, a WETHMock is deployed on local networks)
# WETH_ADDRESS=0x...
