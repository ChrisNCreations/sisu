# The repo is npm-only (yarn.lock removed 2026-09-15).
# @nomicfoundation/hardhat-toolbox@3 peer-depends on hardhat-verify@^1, but this project
# pins hardhat-verify@^2 for the Etherscan v2 API. Yarn v1 ignored that conflict; npm needs
# this flag so `npm install` / `npm ci` resolve the tree the same way the lock was built.
legacy-peer-deps=true
